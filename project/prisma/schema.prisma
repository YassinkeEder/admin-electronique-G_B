// prisma/schema.prisma
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}



// ============================================================================
// ENUMS - Match Supabase PostgreSQL enum types
// ============================================================================

enum UserRole {
  admin
  chef_projet
  decideur
  public

  @@map("user_role")
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SUSPENDED
  CANCELLED

  @@map("project_status")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("task_priority")
}

enum KpiType {
  budget_variance
  roi
  delay_index
  completion_rate
  cost_per_beneficiary
  efficiency_score

  @@map("kpi_type")
}

enum ProjectRegion {
  Bissau
  Gabu
  Bafata
  Cacheu
  Oio
  Quinara
  Tombali
  Biombo
  Bolama

  @@map("project_region")
}

enum ProjectSector {
  Health
  Education
  Infrastructure
  Agriculture
  Energy
  ICT
  Finance
  Governance
  Environment

  @@map("project_sector")
}

enum StrategicAxis {
  e_gouvernement
  infrastructure_numerique
  inclusion_numerique
  cybersecurite
  data_et_ia
  economie_numerique

  @@map("strategic_axis")
}

enum PermissionResource {
  projects
  tasks
  metrics
  users
  audit_logs
  documents

  @@map("permission_resource")
}

enum PermissionAction {
  create
  read
  update
  delete
  manage

  @@map("permission_action")
}

enum NotificationType {
  task_overdue
  project_delay
  budget_alert
  comment
  mention
  system

  @@map("notification_type")
}

// ============================================================================
// MODELS
// ============================================================================

/// User profiles (extended auth.users data)
model Profile {
  id        String   @id @db.Uuid
  fullName  String   @default("") @map("full_name")
  email     String   @default("")
  role      UserRole @default(public)
  department String?
  phone     String?
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  createdProjects  Project[]         @relation("created_by")
  updatedProjects  Project[]         @relation("updated_by")
  assignedTasks    Task[]            @relation("assigned_to")
  createdTasks     Task[]            @relation("created_by")
  comments         Comment[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  organizations    UserOrganization[]

  @@map("profiles")
  @@index([email])
}

/// Public sector projects
model Project {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  name         String
  description  String        @default("")
  budgetXof    BigInt        @default(0) @map("budget_xof")
  spentXof     BigInt        @default(0) @map("spent_xof")
  startDate    DateTime      @db.Date @map("start_date")
  endDate      DateTime      @db.Date @map("end_date")
  status       ProjectStatus @default(PLANNED)
  region       ProjectRegion @default(Bissau)
  sector       ProjectSector @default(Governance)
  strategicAxis StrategicAxis @default(e_gouvernement) @map("strategic_axis")
  isPublic     Boolean       @default(true) @map("is_public")
  progress     Int           @default(0) @db.SmallInt
  beneficiaries Int          @default(0)
  createdBy    String?       @map("created_by") @db.Uuid
  updatedBy    String?       @map("updated_by") @db.Uuid
  isArchived   Boolean       @default(false) @map("is_archived")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  creator     Profile?          @relation("created_by", fields: [createdBy], references: [id], onDelete: SetNull)
  updater     Profile?          @relation("updated_by", fields: [updatedBy], references: [id], onDelete: SetNull)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tasks       Task[]
  metrics     Metric[]
  comments    Comment[]
  
  @@map("projects")
  @@index([status])
  @@index([region])
  @@index([sector])
  @@index([strategicAxis])
  @@index([organizationId])
}

/// Project tasks
model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  title       String
  description String     @default("")
  progress    Int        @default(0) @db.SmallInt
  status      TaskStatus @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  startDate   DateTime?  @db.Date @map("start_date")
  dueDate     DateTime?  @db.Date @map("due_date")
  completedAt DateTime?  @map("completed_at") @db.Timestamptz()
  assignedTo  String?    @map("assigned_to") @db.Uuid
  createdBy   String?    @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  Profile? @relation("assigned_to", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator   Profile? @relation("created_by", fields: [createdBy], references: [id], onDelete: SetNull)
  comments  Comment[]

  @@map("tasks")
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
}

/// KPI metrics for projects
model Metric {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  kpiType      KpiType  @map("kpi_type")
  value        Float
  unit         String
  targetValue  Float    @map("target_value")
  periodLabel  String   @map("period_label")
  recordedAt   DateTime @map("recorded_at") @db.Timestamptz()

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("metrics")
  @@index([projectId])
  @@index([recordedAt])
}

/// Audit trail for compliance & tracking
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  tableName    String   @map("table_name")
  recordId     String?  @map("record_id") @db.Uuid
  oldData      Json?    @map("old_data")
  newData      Json?    @map("new_data")
  actionType   String?  @map("action_type")
  resourceType String?  @map("resource_type")
  changes      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([userId])
  @@index([tableName])
  @@index([createdAt])
}

/// Collaboration comments on projects/tasks
model Comment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content      String
  authorId     String?  @map("author_id") @db.Uuid
  projectId    String?  @map("project_id") @db.Uuid
  taskId       String?  @map("task_id") @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  author   Profile?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  project  Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent   Comment?   @relation("nested", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[]  @relation("nested")

  @@map("comments")
  @@index([authorId])
  @@index([projectId])
  @@index([taskId])
}

/// Real-time notifications
model Notification {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  type            NotificationType
  title           String
  message         String?
  relatedResource String?          @map("related_resource")
  relatedId       String?          @map("related_id") @db.Uuid
  isRead          Boolean          @default(false) @map("is_read")
  readAt          DateTime?        @map("read_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

/// Organizations (ministries/agencies)
model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  slug        String?  @unique
  region      ProjectRegion?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  projects    Project[]
  users       UserOrganization[]

  @@map("organizations")
  @@index([isActive])
}

/// Users linked to organizations
model UserOrganization {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           String   @default("member")
  isAdmin        Boolean  @default(false) @map("is_admin")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("user_organizations")
  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Fine-grained permissions
model Permission {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  resource    PermissionResource
  action      PermissionAction
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
  @@unique([resource, action])
}

/// Map roles to permissions
model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role         UserRole
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@map("role_permissions")
  @@unique([role, permissionId])
}
