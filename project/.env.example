# ==========================
# Environment variables (example)
# ==========================

# PUBLIC (client) - VITE_ variables are embedded in the front-end bundle and
# are safe to expose. Only include the ANON key here.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"
VITE_API_URL="http://localhost:3001"

# ------------------------------------------------------------------
# SERVER / PRIVATE - DO NOT COMMIT
# These variables MUST remain on the server, in CI secrets or secret manager
# ------------------------------------------------------------------
# SUPABASE_URL and SUPABASE_ANON_KEY are optional server-side helpers.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY_IF_NEEDED_SERVER_SIDE"

# IMPORTANT: SERVICE ROLE KEY (ADMIN) — PRIVATE
# Use this only in server-side processes (Node server, Edge Functions) and
# store it in your deployment secrets (GitHub Secrets / platform env vars).
# NEVER put this value in the client, in VITE_ variables, or commit it.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY"

# Postgres connection strings (examples) - store privately
DATABASE_URL="postgresql://user:password@host:5432/postgres"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/postgres"
ML_API_URL="http://localhost:8001"

# Notes:
# - If a secret was accidentally committed, rotate it immediately in Supabase
#   (Project Settings → API → Rotate service role key) and remove the value
#   from the repository history.
# - In CI / GH Actions, set `SUPABASE_SERVICE_ROLE_KEY` in repository / org secrets
#   and reference it from the workflow; do not write it into any file checked-in.


